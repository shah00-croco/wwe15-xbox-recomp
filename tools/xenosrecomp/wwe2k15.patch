+// WWE 2K15: some shaders use float/int constants and texture fetch constants
+// that have no entry in their constant table. Declare them as raw loads from
+// the constant buffers (SPIR-V; DXIL gets zero placeholders for now).
+// WWE 2K15: rewrite the generated SPIR-V constant reads from buffer device
+// addresses to the storage buffers in shader_common.h, and texture/sampler
+// descriptor indices to the fetch constant number itself (set 1 has one slot
+// per fetch constant).
+static void convertToStorageBufferBindings(std::string& out)
+{
+    static const std::regex floatLoad(R"(vk::RawBufferLoad<float4>\(g_PushConstants\.(Vertex|Pixel)ShaderConstants \+ (.+?), 0x10\))");
+    out = std::regex_replace(out, floatLoad, "asfloat(g_$1ShaderConstantsBuffer.Load4($2))");
+
+    static const std::regex intLoad(R"(vk::RawBufferLoad<int4>\(g_PushConstants\.SharedConstants \+ (\d+)\))");
+    out = std::regex_replace(out, intLoad, "asint(g_SharedConstantsBuffer.Load4($1))");
+
+    static const std::regex indexLoad(R"(vk::RawBufferLoad<uint>\(g_PushConstants\.SharedConstants \+ (\d+)\))");
+    std::string result;
+    auto begin = out.cbegin();
+    for (std::sregex_iterator it(out.begin(), out.end(), indexLoad), end; it != end; ++it)
+    {
+        uint32_t offset = uint32_t(std::stoul((*it)[1].str()));
+        uint32_t fetchConstant = offset < 384 ? (offset % 128) / 4 : (offset - 384) / 4;
+        result.append(begin, out.cbegin() + it->position());
+        result += std::to_string(fetchConstant);
+        begin = out.cbegin() + it->position() + it->length();
+    }
+    result.append(begin, out.cend());
+    out = std::move(result);
+}
+
+static void addUnnamedRegisterFallbacks(std::string& out, bool isPixelShader)
+{
+    size_t mainPos = out.find("void main(");
+    if (mainPos == std::string::npos)
+        return;
+
+    auto collect = [&](const std::regex& use, const char* declFormat)
+    {
+        std::set<uint32_t> regs;
+        for (auto it = std::sregex_iterator(out.begin() + mainPos, out.end(), use); it != std::sregex_iterator(); ++it)
+        {
+            uint32_t reg = uint32_t(std::stoul((*it)[1].str()));
+            if (out.find(fmt::format(fmt::runtime(declFormat), reg)) == std::string::npos)
+                regs.insert(reg);
+        }
+        return regs;
+    };
+
+    auto floatRegs = collect(std::regex(R"(\bc(\d+)\b)"), "float4 c{} =");
+    auto intRegs = collect(std::regex(R"(\bi(\d+)\b)"), "int4 i{} =");
+    auto samplerRegs = collect(std::regex(R"(\bs(\d+)_(?:Texture(?:2D|3D|Cube)|Sampler)DescriptorIndex\b)"), "#define s{}_SamplerDescriptorIndex");
+
+    if (floatRegs.empty() && intRegs.empty() && samplerRegs.empty())
+        return;
+
+    std::string block = "#ifdef __spirv__\n";
+    for (uint32_t reg : floatRegs)
+        block += fmt::format("#define c{} vk::RawBufferLoad<float4>(g_PushConstants.{}ShaderConstants + {}, 0x10)\n", reg, isPixelShader ? "Pixel" : "Vertex", reg * 16);
+    for (uint32_t reg : intRegs)
+        block += fmt::format("#define i{} vk::RawBufferLoad<int4>(g_PushConstants.SharedConstants + {})\n", reg, 1024 + reg * 16);
+    for (uint32_t reg : samplerRegs)
+    {
+        for (size_t j = 0; j < std::size(TEXTURE_DIMENSIONS); j++)
+            block += fmt::format("#define s{}_Texture{}DescriptorIndex vk::RawBufferLoad<uint>(g_PushConstants.SharedConstants + {})\n", reg, TEXTURE_DIMENSIONS[j], j * 128 + reg * 4);
+        block += fmt::format("#define s{}_SamplerDescriptorIndex vk::RawBufferLoad<uint>(g_PushConstants.SharedConstants + {})\n", reg, std::size(TEXTURE_DIMENSIONS) * 128 + reg * 4);
+    }
+    block += "#else\n";
+    for (uint32_t reg : floatRegs)
+        block += fmt::format("#define c{} float4(0.0, 0.0, 0.0, 0.0)\n", reg);
+    for (uint32_t reg : intRegs)
+        block += fmt::format("#define i{} int4(0, 0, 0, 0)\n", reg);
+    for (uint32_t reg : samplerRegs)
+    {
+        for (size_t j = 0; j < std::size(TEXTURE_DIMENSIONS); j++)
+            block += fmt::format("#define s{}_Texture{}DescriptorIndex 0\n", reg, TEXTURE_DIMENSIONS[j]);
+        block += fmt::format("#define s{}_SamplerDescriptorIndex 0\n", reg);
+    }
+    block += "#endif\n";
+
+    out.insert(mainPos, block);
+}
